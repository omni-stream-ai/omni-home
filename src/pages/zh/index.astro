---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WorkflowBoard from "../../components/WorkflowBoard";
import FaqAccordion from "../../components/FaqAccordion";
import { getLocaleContent } from "../../i18n";

const t = getLocaleContent("zh");

const homepageJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://omnistreamai.com/#organization",
      name: "Omni Stream AI",
      url: "https://omnistreamai.com",
      sameAs: [
        "https://github.com/omni-stream-ai/omni-code",
        "https://github.com/omni-stream-ai/omni-code-bridge"
      ]
    },
    {
      "@type": "WebSite",
      "@id": "https://omnistreamai.com/#website",
      url: "https://omnistreamai.com",
      name: "Omni Stream AI",
      publisher: { "@id": "https://omnistreamai.com/#organization" }
    },
    {
      "@type": "SoftwareApplication",
      "@id": "https://omnistreamai.com/#omnicode",
      name: "Omni Code",
      applicationCategory: "DeveloperApplication",
      operatingSystem: "Android, macOS, Windows, Linux, Web",
      url: "https://code.omnistreamai.com",
      downloadUrl: "https://omnistreamai.com/zh/products/omni-code/download",
      description: t.meta.homeDescription,
      isAccessibleForFree: true,
      sameAs: [
        "https://github.com/omni-stream-ai/omni-code",
        "https://github.com/omni-stream-ai/omni-code-bridge"
      ],
      publisher: { "@id": "https://omnistreamai.com/#organization" },
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" }
    }
  ]
};
---

<BaseLayout title={t.meta.homeTitle} description={t.meta.homeDescription} jsonLd={homepageJsonLd}>
  <main class="site-shell">
    <section class="hero hero-home">
      <div class="hero-orb hero-orb-one" aria-hidden="true"></div>
      <div class="hero-orb hero-orb-two" aria-hidden="true"></div>
      <div class="hero-gridline" aria-hidden="true"></div>
      <header class="topbar">
        <a class="brand" href="/zh">
          <span class="brand-mark">
            <img src="/omni-code-logo.svg" alt="Omni Code logo" />
          </span>
          <span class="brand-copy">
            <strong>Omni Stream AI</strong>
            <small>omnistreamai.com</small>
          </span>
        </a>

        <nav class="topnav" aria-label="Primary">
          <a class="is-active" href="#product" aria-current="page">{t.nav.omniCode}</a>
          <span class="topnav-future" aria-label="More products planned">
            {t.nav.moreProducts}
            <span class="topnav-badge">{t.nav.future}</span>
          </span>
          <a class="lang-switch" href="/" aria-label="Switch to English">EN</a>
        </nav>
      </header>

      <div class="hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">{t.hero.eyebrow}</p>
          <div class="hero-pill-row">
            {t.hero.pills.map((pill) => <span class="hero-pill">{pill}</span>)}
          </div>
          <h1>{t.hero.headline}</h1>
          <p class="hero-lead">{t.hero.lead}</p>

          <div class="hero-actions">
            <a class="button button-primary" href="https://code.omnistreamai.com" target="_blank" rel="noreferrer">
              {t.hero.ctaTryWeb}
            </a>
            <a class="button button-secondary" href="/zh/products/omni-code/download">
              {t.hero.ctaDownload}
            </a>
            <a class="button button-secondary" href="https://github.com/omni-stream-ai/omni-code" target="_blank" rel="noreferrer">
              {t.hero.ctaGitHub}
            </a>
          </div>
        </div>

        <div class="hero-stage launch-stage" aria-label="Product preview">
          <div class="launch-orb launch-orb-primary" aria-hidden="true"></div>
          <div class="launch-orb launch-orb-secondary" aria-hidden="true"></div>

          <div class="launch-device-shell">
            <div class="launch-device-glow" aria-hidden="true"></div>
            <div class="launch-device">
              <div class="launch-device-top">
                <span class="launch-dot"></span>
                <span class="launch-device-label">{t.launch.availableNow}</span>
                <span class="launch-chip">Omni Code</span>
              </div>

              <div class="launch-device-screen">
                <div class="launch-panel launch-panel-voice">
                  <p class="launch-panel-label">Omni Code</p>
                  <strong>{t.launch.remoteControl}</strong>
                  <div class="voice-wave" aria-hidden="true">
                    <span></span><span></span><span></span><span></span><span></span><span></span><span></span>
                  </div>
                  <p>{t.launch.voiceInput}</p>
                </div>

                <div class="launch-panel launch-panel-approval">
                  <p class="launch-panel-label">{t.launch.whyExists}</p>
                  <strong>{t.launch.makeNative}</strong>
                  <p>{t.launch.keepCoding}</p>
                  <div class="launch-pill-row">
                    <span>{t.stories.visual.voiceSession.split(" ")[0]}</span>
                    <span>{t.stories.items[1].eyebrow.split(" ").pop()}</span>
                    <span>{t.stories.items[2].eyebrow.split(" ").pop()}</span>
                  </div>
                </div>

                <div class="launch-metrics">
                  <article><small>{t.launch.transport}</small><strong>HTTP + SSE</strong></article>
                  <article><small>{t.launch.voiceLoop}</small><strong>STT / TTS</strong></article>
                  <article><small>{t.launch.replies}</small><strong>Brief mode</strong></article>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="stat-strip">
      {t.stats.map((item, i) => (
        <article class="stat-card">
          <span class="stat-index">0{i + 1}</span>
          <strong>{item.value}</strong>
          <p>{item.label}</p>
        </article>
      ))}
    </section>

    <section id="product" class="section section-story">
      <div class="section-heading">
        <p class="eyebrow">{t.stories.eyebrow}</p>
        <h2>{t.stories.heading}</h2>
        <p>{t.stories.intro}</p>
      </div>

      <div class="story-stack">
        {t.stories.items.map((story, index) => (
          <article class={`story-section ${index % 2 === 1 ? "story-section-reverse" : ""}`}>
            <div class="story-copy">
              <p class="eyebrow">{story.eyebrow}</p>
              <h3>{story.title}</h3>
              <p>{story.body}</p>
              <a class="story-link" href={`/zh${story.ctaHref}`}>{story.ctaLabel}</a>
            </div>

            <div class={`story-visual story-visual-${index === 0 ? "voice" : index === 1 ? "approval" : "bridge"}`} aria-hidden="true">
              <div class="story-visual-card">
                {index === 0 && (
                  <>
                    <span class="story-visual-label">{t.stories.visual.voiceSession}</span>
                    <strong>{t.stories.visual.askForChange}</strong>
                    <div class="story-wave">
                      <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
                    </div>
                  </>
                )}
                {index === 1 && (
                  <>
                    <span class="story-visual-label">{t.stories.visual.approvalRequest}</span>
                    <strong>{t.stories.visual.pauseBefore}</strong>
                    <div class="story-action-row">
                      <span>{t.stories.visual.approve}</span>
                      <span>{t.stories.visual.askContext}</span>
                      <span>{t.stories.visual.deny}</span>
                    </div>
                  </>
                )}
                {index === 2 && (
                  <>
                    <span class="story-visual-label">{t.stories.visual.bridgeStatus}</span>
                    <strong>{t.stories.visual.keepPath}</strong>
                    <div class="story-metrics">
                      {story.metricItems?.map((item) => (
                        <div><small>{item.label}</small><strong>{item.value}</strong></div>
                      ))}
                    </div>
                  </>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section section-architecture">
      <div class="section-heading">
        <p class="eyebrow">{t.features.eyebrow}</p>
        <h2>{t.features.heading}</h2>
        <p>{t.features.intro}</p>
      </div>

      <div class="feature-grid feature-grid-compact">
        {t.features.items.map((feature) => (
          <article class="feature-card">
            <p class="feature-accent">{feature.accent}</p>
            <h3>{feature.title}</h3>
            <p>{feature.body}</p>
            <span class="feature-arrow">{t.features.exploreCta}</span>
          </article>
        ))}
      </div>
    </section>

    <section id="workflow" class="section section-workflow">
      <div class="section-heading">
        <p class="eyebrow">{t.workflow.eyebrow}</p>
        <h2>{t.workflow.heading}</h2>
        <p>{t.workflow.intro}</p>
      </div>
      <WorkflowBoard steps={t.workflow.steps} client:load />
    </section>

    <section id="faq" class="section section-faq">
      <div class="section-heading">
        <p class="eyebrow">{t.faq.eyebrow}</p>
        <h2>{t.faq.heading}</h2>
      </div>
      <FaqAccordion items={t.faq.items} client:visible />
    </section>

    <footer class="footer">
      <p>{t.footer.description}</p>
      <div class="footer-links">
        <a href="https://code.omnistreamai.com" target="_blank" rel="noreferrer">{t.footer.webApp}</a>
        <a href="https://github.com/omni-stream-ai/omni-code" target="_blank" rel="noreferrer">{t.footer.client}</a>
        <a href="https://github.com/omni-stream-ai/omni-code-bridge" target="_blank" rel="noreferrer">{t.footer.bridge}</a>
        <a href="https://github.com/omni-stream-ai/omni-code/releases" target="_blank" rel="noreferrer">{t.footer.releases}</a>
      </div>
    </footer>
  </main>
</BaseLayout>
