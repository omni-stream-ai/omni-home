---
import BaseLayout from "../layouts/BaseLayout.astro";
import WorkflowBoard from "../components/WorkflowBoard";
import FaqAccordion from "../components/FaqAccordion";
import { faq, features, productStories, stats, workflow } from "../content/site";

const title = "Omni Code | Remote Control for Desktop Coding Agents";
const description =
  "Omni Code is a remote client for desktop coding-agent sessions with voice control, approvals, brief replies, and a self-hosted bridge.";
const homepageJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://omnistreamai.com/#organization",
      name: "Omni Stream AI",
      url: "https://omnistreamai.com",
      sameAs: [
        "https://github.com/omni-stream-ai/omni-code",
        "https://github.com/omni-stream-ai/omni-code-bridge"
      ]
    },
    {
      "@type": "WebSite",
      "@id": "https://omnistreamai.com/#website",
      url: "https://omnistreamai.com",
      name: "Omni Stream AI",
      publisher: {
        "@id": "https://omnistreamai.com/#organization"
      }
    },
    {
      "@type": "SoftwareApplication",
      "@id": "https://omnistreamai.com/#omnicode",
      name: "Omni Code",
      applicationCategory: "DeveloperApplication",
      operatingSystem: "Android, macOS, Windows, Linux, Web",
      url: "https://code.omnistreamai.com",
      downloadUrl: "https://omnistreamai.com/products/omni-code/download",
      description,
      isAccessibleForFree: true,
      featureList: [
        "Voice input and spoken replies",
        "AI-assisted approval with manual fallback",
        "Self-hosted bridge over HTTP and SSE",
        "Brief replies through system-prompt compression",
        "Web app accessible from any browser"
      ],
      sameAs: [
        "https://github.com/omni-stream-ai/omni-code",
        "https://github.com/omni-stream-ai/omni-code-bridge"
      ],
      publisher: {
        "@id": "https://omnistreamai.com/#organization"
      },
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD"
      }
    }
  ]
};
---

<BaseLayout title={title} description={description} jsonLd={homepageJsonLd}>
  <main class="site-shell">
    <section class="hero hero-home">
      <div class="hero-orb hero-orb-one" aria-hidden="true"></div>
      <div class="hero-orb hero-orb-two" aria-hidden="true"></div>
      <div class="hero-gridline" aria-hidden="true"></div>
      <header class="topbar">
        <a class="brand" href="/">
          <span class="brand-mark">
            <img src="/omni-code-logo.svg" alt="Omni Code logo" />
          </span>
          <span class="brand-copy">
            <strong>Omni Stream AI</strong>
            <small>omnistreamai.com</small>
          </span>
        </a>

        <nav class="topnav" aria-label="Primary">
          <a class="is-active" href="#product" aria-current="page">Omni Code</a>
          <span class="topnav-future" aria-label="More products planned">
            More products
            <span class="topnav-badge">Future</span>
          </span>
        </nav>
      </header>

      <div class="hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Remote control for local coding agents</p>
          <div class="hero-pill-row">
            <span class="hero-pill">Omni Code</span>
            <span class="hero-pill">Voice-first</span>
            <span class="hero-pill">Human-in-loop</span>
            <span class="hero-pill">Web + Native</span>
          </div>
          <h1>Control the agent from anywhere.</h1>
          <p class="hero-lead">
            Omni Code lets you speak to the agent, approve sensitive actions, hear replies back,
            and keep the control path on a bridge you own.
          </p>

          <div class="hero-actions">
            <a class="button button-primary" href="https://code.omnistreamai.com" target="_blank" rel="noreferrer">
              Try Web
            </a>
            <a class="button button-secondary" href="/products/omni-code/download">
              Download
            </a>
            <a class="button button-secondary" href="https://github.com/omni-stream-ai/omni-code" target="_blank" rel="noreferrer">
              GitHub
            </a>
          </div>
        </div>

        <div class="hero-stage launch-stage" aria-label="Product preview">
          <div class="launch-orb launch-orb-primary" aria-hidden="true"></div>
          <div class="launch-orb launch-orb-secondary" aria-hidden="true"></div>

          <div class="launch-device-shell">
            <div class="launch-device-glow" aria-hidden="true"></div>
            <div class="launch-device">
              <div class="launch-device-top">
                <span class="launch-dot"></span>
                <span class="launch-device-label">Available now</span>
                <span class="launch-chip">Omni Code</span>
              </div>

              <div class="launch-device-screen">
                <div class="launch-panel launch-panel-voice">
                  <p class="launch-panel-label">Omni Code</p>
                  <strong>Remote control for desktop coding agents</strong>
                  <div class="voice-wave" aria-hidden="true">
                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>
                  </div>
                  <p>Voice input, spoken replies, approvals, and bridge-based control in one client.</p>
                </div>

                <div class="launch-panel launch-panel-approval">
                  <p class="launch-panel-label">Why it exists</p>
                  <strong>Make remote supervision feel native instead of bolted on.</strong>
                  <p>Keep the coding session on your own machine while giving the human better ways to hear, answer, and approve.</p>
                  <div class="launch-pill-row">
                    <span>Voice</span>
                    <span>Approval</span>
                    <span>Bridge</span>
                  </div>
                </div>

                <div class="launch-metrics">
                  <article>
                    <small>Transport</small>
                    <strong>HTTP + SSE</strong>
                  </article>
                  <article>
                    <small>Voice loop</small>
                    <strong>STT / TTS</strong>
                  </article>
                  <article>
                    <small>Replies</small>
                    <strong>Brief mode</strong>
                  </article>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="stat-strip">
      {
        stats.map((item) => (
          <article class="stat-card">
            <span class="stat-index">0{stats.indexOf(item) + 1}</span>
            <strong>{item.value}</strong>
            <p>{item.label}</p>
          </article>
        ))
      }
    </section>

    <section id="product" class="section section-story">
      <div class="section-heading">
        <p class="eyebrow">Omni Code</p>
        <h2>Voice, approvals, and bridge control in one client.</h2>
        <p>
          Omni Code wraps desktop coding-agent sessions in a cleaner remote control layer.
        </p>
      </div>

      <div class="story-stack">
        {
          productStories.map((story, index) => (
            <article class={`story-section ${index % 2 === 1 ? "story-section-reverse" : ""}`}>
              <div class="story-copy">
                <p class="eyebrow">{story.eyebrow}</p>
                <h3>{story.title}</h3>
                <p>{story.body}</p>
                <a class="story-link" href={story.ctaHref}>{story.ctaLabel}</a>
              </div>

              <div class={`story-visual story-visual-${story.visual}`} aria-hidden="true">
                <div class="story-visual-card">
                  {
                    story.visual === "voice" && (
                      <>
                        <span class="story-visual-label">Voice session</span>
                        <strong>Ask for the next change out loud.</strong>
                        <div class="story-wave">
                          <span></span>
                          <span></span>
                          <span></span>
                          <span></span>
                          <span></span>
                          <span></span>
                          <span></span>
                          <span></span>
                        </div>
                      </>
                    )
                  }
                  {
                    story.visual === "approval" && (
                      <>
                        <span class="story-visual-label">Approval request</span>
                        <strong>Pause before the risky step.</strong>
                        <div class="story-action-row">
                          <span>Approve</span>
                          <span>Ask for context</span>
                          <span>Deny</span>
                        </div>
                      </>
                    )
                  }
                  {
                    story.visual === "bridge" && (
                      <>
                        <span class="story-visual-label">Bridge status</span>
                        <strong>Keep the control path close to your machine.</strong>
                        <div class="story-metrics">
                          {story.metricItems?.map((item) => (
                            <div>
                              <small>{item.label}</small>
                              <strong>{item.value}</strong>
                            </div>
                          ))}
                        </div>
                      </>
                    )
                  }
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section section-architecture">
      <div class="section-heading">
        <p class="eyebrow">Core surface</p>
        <h2>What the product actually covers.</h2>
        <p>
          Remote access, approval gates, voice, and a bridge you control.
        </p>
      </div>

      <div class="feature-grid feature-grid-compact">
        {
          features.map((feature) => (
            <article class="feature-card">
              <p class="feature-accent">{feature.accent}</p>
              <h3>{feature.title}</h3>
              <p>{feature.body}</p>
              <span class="feature-arrow">Explore the product surface</span>
            </article>
          ))
        }
      </div>
    </section>

    <section id="workflow" class="section section-workflow">
      <div class="section-heading">
        <p class="eyebrow">Omni Code flow</p>
        <h2>How Omni Code works in practice.</h2>
        <p>
          Attach to the bridge, resume the session, approve what matters, and answer by text or voice.
        </p>
      </div>

      <WorkflowBoard steps={workflow} client:load />
    </section>

    <section id="faq" class="section section-faq">
      <div class="section-heading">
        <p class="eyebrow">FAQ</p>
        <h2>Common questions about Omni Code.</h2>
      </div>

      <FaqAccordion items={faq} client:load />
    </section>

    <footer class="footer">
      <p>Omni Code is the remote client for desktop coding-agent supervision.</p>
      <div class="footer-links">
        <a href="https://code.omnistreamai.com" target="_blank" rel="noreferrer">Web App</a>
        <a href="https://github.com/omni-stream-ai/omni-code" target="_blank" rel="noreferrer">Client</a>
        <a href="https://github.com/omni-stream-ai/omni-code-bridge" target="_blank" rel="noreferrer">Bridge</a>
        <a href="https://github.com/omni-stream-ai/omni-code/releases" target="_blank" rel="noreferrer">Releases</a>
      </div>
    </footer>
  </main>
</BaseLayout>
