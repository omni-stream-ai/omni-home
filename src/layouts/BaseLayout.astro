---
import "../styles/global.css";

type Props = {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>;
};

const { title, description, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og-cover.svg", Astro.site);
const defaultJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Omni Code",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Android, iOS, macOS, Windows, Linux",
  url: "https://omnistreamai.com",
  description,
  sameAs: [
    "https://github.com/omni-stream-ai/omni-code",
    "https://github.com/omni-stream-ai/omni-code-bridge"
  ],
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD"
  }
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.png" type="image/png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Omni Code" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="robots" content="index,follow,max-image-preview:large" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd ?? defaultJsonLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>
