---
import "../styles/global.css";

type Props = {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>;
  ogImageAlt?: string;
  themeColor?: string;
};

const {
  title,
  description,
  jsonLd,
  ogImageAlt = "Omni Code by Omni Stream AI",
  themeColor = "#f3efe7"
} = Astro.props;

const locale = Astro.locals.locale ?? "en";
const lang = locale === "zh" ? "zh-CN" : "en";
const ogLocale = locale === "zh" ? "zh_CN" : "en_US";
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og-cover.svg", Astro.site);

const pathname = Astro.url.pathname;
const basePath = pathname.replace(/^\/zh/, "") || "/";
const alternateEn = new URL(basePath, Astro.site);
const alternateZh = new URL(`/zh${basePath === "/" ? "" : basePath}`, Astro.site);

const switchLabel = locale === "zh" ? "EN" : "中文";
const switchHref = locale === "zh" ? alternateEn.pathname : alternateZh.pathname;
const isHomepage = pathname === "/" || pathname === "/zh/" || pathname === "/zh";

const defaultJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Omni Stream AI",
  url: "https://omnistreamai.com",
  description,
  sameAs: [
    "https://github.com/omni-stream-ai/omni-code",
    "https://github.com/omni-stream-ai/omni-code-bridge",
    "https://code.omnistreamai.com"
  ]
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={themeColor} />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.png" type="image/png" />

    <link rel="alternate" hreflang="en" href={alternateEn} />
    <link rel="alternate" hreflang="zh-CN" href={alternateZh} />
    <link rel="alternate" hreflang="x-default" href={alternateEn} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    {locale === "zh" && <meta property="og:locale:alternate" content="en_US" />}
    {locale === "en" && <meta property="og:locale:alternate" content="zh_CN" />}
    <meta property="og:site_name" content="Omni Stream AI" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <meta name="robots" content="index,follow,max-image-preview:large" />

    <link rel="preload" href="/fonts/manrope-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/cormorant-garamond-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />

    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      function loadGtag() {
        if (window._gtagLoaded) return;
        window._gtagLoaded = true;
        var s = document.createElement("script");
        s.src = "https://www.googletagmanager.com/gtag/js?id=G-B3FFP293F7";
        s.async = true;
        document.head.appendChild(s);
        gtag("js", new Date());
        gtag("config", "G-B3FFP293F7");
      }
      if ("requestIdleCallback" in window) {
        requestIdleCallback(loadGtag, { timeout: 3000 });
      } else {
        setTimeout(loadGtag, 3000);
      }
    </script>

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd ?? defaultJsonLd)} />
  </head>
  <body>
    <slot />

    {isHomepage && (
      <script is:inline define:vars={{ locale }}>
        (function () {
          if (sessionStorage.getItem("locale-redirected")) return;
          var nav = navigator.language || "";
          var wantZh = /^zh/i.test(nav);
          var isEn = locale === "en";
          if (wantZh && isEn) {
            sessionStorage.setItem("locale-redirected", "1");
            window.location.href = "/zh" + (location.pathname === "/" ? "" : location.pathname);
          } else if (!wantZh && !isEn) {
            sessionStorage.setItem("locale-redirected", "1");
            window.location.href = location.pathname.replace(/^\/zh/, "") || "/";
          }
        })();
      </script>
    )}
  </body>
</html>
